# ===== Secrets / cau hinh rieng (muc 5: khong hardcode API key) =====
.env
*.env
!.env.example
backend/.env
frontend/.env
frontend/.env.local

# ===== Ban sao co so du lieu =====
# Ban ket xuat chua email, mat khau da bam va token dat lai mat khau cua nguoi
# dung that - khong dua len kho ma nguon. Chan dich danh o thu muc goc de cac
# tep di tru trong db/migration khong bi va lay.
/backup.sql
/*.dump.sql

# ===== Java / Maven =====
target/
!.mvn/wrapper/maven-wrapper.jar
*.class
*.jar
*.war

# ===== File nguoi dung upload / audio TTS cache =====
uploads/
backend/uploads/

# Chan them theo duoi tep, khong chi theo thu muc. Hai dong tren da du cho noi
# audio dang nam, nhung mot ban ghi keo nham vao kho ma nguon thi khong bao gio
# nam o cho minh doan truoc - va file audio la thu rat kho go khoi lich su Git
# sau khi da tro thanh mot commit.
*.mp3
*.wav
*.m4a
*.aac
*.ogg
*.flac
*.opus
*.enc

