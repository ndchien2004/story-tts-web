# ============================================================
# Copy file nay thanh `.env` roi dien gia tri that.
# File `.env` da duoc loai tru khoi Git (xem .gitignore) - muc 5 de bai.
# ============================================================

# ---------- Database (MySQL chay bang Docker Compose) ----------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=story_tts
DB_USER=storytts
DB_PASSWORD=storytts
MYSQL_ROOT_PASSWORD=rootpass

# ---------- JWT ----------
# Bat buoc doi thanh chuoi ngau nhien >= 32 ky tu khi chay that.
# Sinh nhanh: openssl rand -base64 48
JWT_SECRET=doi-chuoi-nay-thanh-secret-ngau-nhien-dai-it-nhat-32-ky-tu
JWT_EXPIRATION_MS=86400000

# ---------- Tai khoan Admin khoi tao lan dau ----------
APP_ADMIN_USERNAME=admin
APP_ADMIN_EMAIL=admin@storytts.local
APP_ADMIN_PASSWORD=Admin@123

# ---------- CORS (frontend Vite) ----------
# Vite tu doi cong neu 5173 dang ban, nen liet ke san vai cong lien tiep.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173

# ---------- Luu tru file ----------
AUDIO_DIR=./uploads/audio
COVER_DIR=./uploads/covers

# ---------- TTS: thu tu nha cung cap ----------
# He thong thu lan luot theo thu tu nay. Nha cung cap nao chua co API key
# thi bi bo qua, nen chi can dien key la no tu duoc dung.
TTS_PROVIDERS=fptai,elevenlabs

# ---------- TTS: FPT.AI (giong Viet) ----------
# Lay API key mien phi tai https://fpt.ai/tts (Dashboard -> API Key)
FPT_TTS_API_KEY=
FPT_TTS_VOICE=banmai
FPT_TTS_SPEED=0

# ---------- TTS: ElevenLabs (du phong) ----------
# API key: https://elevenlabs.io -> Profile -> API Keys
ELEVENLABS_API_KEY=
# Giong doc mac dinh, dung khi ElevenLabs phai thay the FPT.AI.
# Lay voice_id trong muc Voices tren trang ElevenLabs (hoac de trong roi chon
# giong trong app sau khi da dien API key - app tu tai danh sach giong ve).
ELEVENLABS_VOICE_ID=
# Bat buoc dung model da ngon ngu thi tieng Viet moi doc dung.
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

SERVER_PORT=8080
