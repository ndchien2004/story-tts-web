# ============================================================
# Copy file nay thanh `.env` roi dien gia tri that.
# File `.env` da duoc loai tru khoi Git (xem .gitignore) - muc 5 de bai.
# ============================================================

# ---------- Database (MySQL chay bang Docker Compose) ----------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=story_tts
DB_USER=storytts
DB_PASSWORD=storytts
MYSQL_ROOT_PASSWORD=rootpass
# Hai dong duoi chi can khi thue MySQL o ben ngoai (Aiven, PlanetScale...).
# DISABLED = khong ma hoa duong truyen, dung cho MySQL chay ngay tren may minh.
# REQUIRED = bat ma hoa; hau het nha cung cap deu bat buoc.
DB_SSL_MODE=DISABLED
# Nha cung cap cap san mot co so du lieu va khong cho tai khoan tu tao them,
# luc do dat false, neu khong se loi ngay khi mo ket noi.
# Aiven la mot truong hop nhu vay: dat false, va DB_SSL_MODE=REQUIRED.
DB_CREATE_IF_MISSING=true
# Goi mien phi thuong chi cho vai chuc ket noi cho ca tai khoan.
DB_POOL_SIZE=10

# ---------- JWT ----------
# Bat buoc doi thanh chuoi ngau nhien >= 32 ky tu khi chay that.
# Sinh nhanh: openssl rand -base64 48
JWT_SECRET=doi-chuoi-nay-thanh-secret-ngau-nhien-dai-it-nhat-32-ky-tu
JWT_EXPIRATION_MS=86400000

# ---------- Tai khoan Admin khoi tao lan dau ----------
APP_ADMIN_USERNAME=admin
APP_ADMIN_EMAIL=admin@storytts.local
APP_ADMIN_PASSWORD=Admin@123

# ---------- CORS (frontend Vite) ----------
# Vite tu doi cong neu 5173 dang ban, nen liet ke san vai cong lien tiep.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173

# ---------- Luu tru file ----------
# local      = he tep cua may dang chay. Dung khi lap trinh o may ca nhan.
# cloudinary = cung tai khoan dang dung cho anh dai dien.
#
# BAT BUOC dat `cloudinary` khi chay tren Render: he tep o do la tam thoi, bi
# xoa sach moi lan trien khai lai, khoi dong lai, va moi lan dich vu ngu sau 15
# phut vang khach. De `local` o do nghia la moi ban audio dung bang ElevenLabs -
# mat tien that cho tung ban - deu bien mat trong vong mot gio.
STORAGE_DRIVER=local

# Hai duong dan duoi chi co nghia khi STORAGE_DRIVER=local.
AUDIO_DIR=./uploads/audio
# Nhac nen quan tri vien tai len cho nguoi nghe chon.
BGM_DIR=./uploads/bgm

# Giu mot ban audio da loi thoi bao lau (gio) truoc khi xoa file cua no.
#
# Ban audio thanh loi thoi ngay luc Admin sua noi dung chuong, nhung file chua
# bi xoa ngay: rat co the dang co nguoi nghe do dung file ay, va trang doc co y
# khong cat ngang ho - ho nhan mot loi bao kem nut "Doc noi dung moi" va tu chon
# luc nao thi chuyen. Dat 0 de tat han viec don (huu ich khi dang do loi).
AUDIO_STALE_RETENTION_HOURS=72

# ---------- Tao audio: ElevenLabs ----------
# API key: https://elevenlabs.io -> Profile -> API Keys
# De trong thi nut "Nghe audio" bao ro la may chu chua cau hinh, phan con lai
# cua web chay binh thuong.
ELEVENLABS_API_KEY=
# Giong doc mac dinh. Lay voice_id trong muc Voices tren trang ElevenLabs;
# day cung la giong duoc dung khi khong ai chi dinh giong nao khac.
ELEVENLABS_VOICE_ID=
# Bat buoc dung model da ngon ngu thi tieng Viet moi doc dung.
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Thu tu thu cac nha cung cap. Hien chi co mot, de day de them nha cung cap
# khac ma khong phai sua ma nguon.
TTS_PROVIDERS=elevenlabs

# ---------- Ngan sach cho nut "Nghe bang AI" cua nguoi doc ----------
# Nguoi doc tu bam tao audio la yeu cau cua de bai, nhung moi ban dung moi la
# mot lan goi API tinh tien. Ban da dung roi thi nghe lai khong ton luot nao,
# nen nhung con so nay chi dem cac ban THAT SU moi.
# Tat han duong nguoi doc; console quan tri van dung audio binh thuong.
TTS_READER_ENABLED=true
# So ban audio moi mot nguoi duoc tao trong ngay. -1 = khong gioi han, 0 = chan han.
TTS_READER_DAILY_QUOTA=3
TTS_READER_DAILY_QUOTA_VIP=10
# Tran chung cho toan bo nguoi doc trong ngay - cau dao cuoi ve chi phi.
TTS_READER_DAILY_QUOTA_GLOBAL=100
# 20000 ky tu ~ 5 lan goi nha cung cap cho mot ban audio.
TTS_READER_MAX_CHARS=20000

SERVER_PORT=8080

# ---------- Tro ly AI doc truyen: Google Gemini ----------
# API key: https://aistudio.google.com/apikey
# De trong thi hop chat AI o trang doc khong hien ra, phan con lai cua web
# chay binh thuong. Key nay CHI ton tai o backend - frontend khong bao gio
# nhin thay no, vi moi loi goi Gemini deu di qua POST /api/ai/story-assistant.
GEMINI_API_KEY=
# Goc cua API. De trong thi dung mac dinh trong application.properties.
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-3.1-flash-lite
# GEMINI_TIMEOUT_SECONDS=30
# GEMINI_MAX_OUTPUT_TOKENS=1024

# Ngan sach cho tro ly. Moi cau hoi gui kem ca noi dung chuong, nen day la cho
# siet chi phi. -1 = khong gioi han, 0 = chan han.
# AI_ASSISTANT_ENABLED=true
# AI_DAILY_QUOTA=20
# AI_DAILY_QUOTA_VIP=50
# AI_DAILY_QUOTA_GLOBAL=500
# AI_MAX_CHAPTER_CHARS=24000
# AI_MAX_QUESTION_CHARS=500
# AI_MAX_HISTORY_TURNS=6

# ---------- Gioi han tan suat ----------
# Chan ke ban request don dap truoc khi bat cu gi dat tien chay: do mat khau,
# doi thu qua form quen mat khau, spam binh luan.
#
# Nhung con so nay duoc chon de KHONG mot nguoi dung that nao cham toi, con ke
# do thi cham ngay o giay thu hai. Ha xuong la siet lai duoc ngay.
# Xem RateLimitRules.java de biet ly le cua tung nhom.
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_LOGIN=10      # / 5 phut - cua dang nhap
# RATE_LIMIT_MAIL=5        # / gio   - dang ky va quen mat khau (hai duong gui thu that)
# RATE_LIMIT_CODE=20       # / gio   - nhap ma OTP, dat lai mat khau
# RATE_LIMIT_AI=10         # / phut  - tao audio va hoi tro ly
# RATE_LIMIT_WRITE=60      # / phut  - binh luan, cham sao, yeu thich
# RATE_LIMIT_ANY=600       # / phut  - cau dao cuoi cho moi loi goi

# Hang rao thu hai cua cua dang nhap: dem theo TAI KHOAN thay vi theo dia chi
# mang, nen ke co san mot dai IP cung khong lach duoc.
#
# Danh doi: nguoi ngoai khoa duoc tai khoan cua nguoi khac trong quang nay bang
# cach co tinh go sai. Chap nhan duoc vi quang nghi tu het, va nguoi bi khoa van
# dat lai duoc mat khau qua email ngay - duong ay khong di qua bo dem nay.
# LOGIN_MAX_FAILURES=10
# LOGIN_LOCK_FOR=15m

# ---------- Cloudinary (anh dai dien nguoi dung + logo) ----------
# Console: https://console.cloudinary.com -> Dashboard -> API Keys.
# De trong thi chuc nang doi anh dai dien tu tat, phan con lai chay binh thuong.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Thu muc goc tren Cloudinary, moi thu deu nam duoi thu muc nay.
CLOUDINARY_FOLDER=story-tts-web

# ---------- Dang nhap bang Google ----------
# https://console.cloud.google.com -> APIs & Services -> Credentials
# -> OAuth client ID, loai "Web application".
# Nho khai bao Authorized JavaScript origins: http://localhost:5173
# Chi can Client ID. Luong dung o day la ID token nen KHONG can client secret.
# De trong thi nut "Dang nhap bang Google" tu an khoi giao dien.
GOOGLE_CLIENT_ID=

# ---------- Email (chuc nang quen mat khau) ----------
# Voi Gmail phai dung "App password" 16 ky tu (bat 2 buoc, roi vao
# https://myaccount.google.com/apppasswords), khong dung duoc mat khau Gmail.
# De trong MAIL_USERNAME thi chuc nang quen mat khau tu tat, phan con lai
# chay binh thuong.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
# Nguoi gui hien trong hop thu. De trong thi lay luon MAIL_USERNAME.
MAIL_FROM=
MAIL_FROM_NAME=Truyen Nghe
# Trang dat lai mat khau cua frontend; token duoc noi vao sau dia chi nay.
MAIL_RESET_URL=http://localhost:5173/dat-lai-mat-khau
MAIL_RESET_TOKEN_TTL_MINUTES=30

# ---------- PayOS (thanh toan nang cap VIP) ----------
# Lay tai https://my.payos.vn -> Kenh thanh toan -> Thong tin xac thuc API.
# De trong thi chuc nang thanh toan tu tat: trang nang cap van hien danh sach
# goi nhung khong tao duoc don, phan con lai chay binh thuong.
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
# Trang ket qua cua frontend; PayOS dua nguoi dung ve day sau khi tra tien.
PAYOS_RETURN_URL=http://localhost:5173/thanh-toan/ket-qua
PAYOS_CANCEL_URL=http://localhost:5173/thanh-toan/ket-qua
